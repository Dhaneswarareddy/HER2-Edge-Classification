<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:title="@string/app_name"
            app:titleTextColor="@color/surface"
            app:subtitle="@string/header_subtitle"
            app:subtitleTextColor="#D0E2EC" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Hardware Spec Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvHardwareBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hardware_info"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvModelSpec"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Model: EfficientNetV2-B0 448 px • TFLite XNNPACK (CPU)"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Configuration Card: Model & Threads -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Precision &amp; Thread Configuration"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/rgModelPrecision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="6dp">

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rbFp16"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="FP16 (Primary)"
                            android:textSize="12sp" />

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rbInt8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="INT8 (speed test only)"
                            android:textSize="12sp" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/threads_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <RadioGroup
                        android:id="@+id/rgThreads"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="4dp">

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rb1Thread"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="1T"
                            android:textSize="12sp" />

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rb2Threads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2T"
                            android:textSize="12sp" />

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rb4Threads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:checked="true"
                            android:text="4T"
                            android:textStyle="bold"
                            android:textSize="12sp" />

                        <RadioButton
                            android:textColor="@color/text_primary"
                            android:buttonTint="@color/accent"
                            android:id="@+id/rb8Threads"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="8T"
                            android:textSize="12sp" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Image Input & Sample Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/ivTilePreview"
                        android:layout_width="220dp"
                        android:layout_height="220dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="8dp"
                        android:background="#EEEEEE"
                        android:scaleType="fitCenter"
                        android:contentDescription="Histopathology Tile Preview" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_sample_title"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginBottom="6dp" />

                    <!-- Quick Sample Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnSample0"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="@string/tile_score_0"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnSample1"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="@string/tile_score_1"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnSample2"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:padding="0dp"
                            android:text="@string/tile_score_2"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnSample3"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="38dp"
                            android:layout_weight="1"
                            android:padding="0dp"
                            android:text="@string/tile_score_3"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPickGallery"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_custom_image"
                        android:textSize="11sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Results Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/inference_result_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Predicted HER2 Score Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/tvPredictionScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/badge_background"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:text="Score --"
                            android:textColor="@color/surface"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tvPredictionStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Status: Pending"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvClinicalAction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Select a tile to run edge inference"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Confidence Bars -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Class probabilities (softmax, not a calibrated certainty)"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Score 0 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="Score 0:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbScore0"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/tvScore0"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.0%"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Score 1+ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="Score 1+:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbScore1"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/tvScore1"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.0%"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Score 2+ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="Score 2+:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbScore2"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/tvScore2"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.0%"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Score 3+ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="Score 3+:"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />

                        <ProgressBar
                            android:id="@+id/pbScore3"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_height="10dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0" />

                        <TextView
                            android:id="@+id/tvScore3"
                            android:layout_width="45dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="0.0%"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Telemetry Benchmarks -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginVertical="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Network latency"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvLatency"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- ms"
                                android:textColor="@color/primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total incl. resize"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvThroughput"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- ms"
                                android:textColor="@color/accent"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Disclaimer Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clinical_disclaimer"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:padding="4dp"
                android:gravity="center" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
